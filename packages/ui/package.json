{
	"name": "@house/ui",
	"private": true,
	"type": "module",
	"exports": {
		"./sidebar": "./src/sidebar/index.ts",
		"./file-navigator": "./src/file-navigator/index.ts"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"format": "oxfmt src/ test/ dev/",
		"format:check": "oxfmt --check src/ test/ dev/",
		"lint": "oxlint --tsconfig tsconfig.json src/ test/ dev/",
		"test": "bun test",
		"evidence:parcel": "HOUSE_UI_RUN_PARCEL_EVIDENCE=1 bun test test/parcel-feasibility.test.ts",
		"evidence:rejected-backend": "HOUSE_UI_RUN_REJECTED_BACKEND_EVIDENCE=1 bun test test/backend-feasibility.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@opentui/core": "0.5.9",
		"@opentui/react": "0.5.9",
		"@parcel/watcher": "2.6.0",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.18",
		"chokidar": "5.0.0",
		"fuzzysort": "3.1.0",
		"ignore": "7.0.5",
		"oxfmt": "0.51.0",
		"oxlint": "1.66.0",
		"react": "19.2.8",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"@opentui/core": "0.5.9",
		"@opentui/react": "0.5.9",
		"react": "19.2.8"
	}
}
