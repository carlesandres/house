{
	"name": "@carlesandres/house",
	"version": "0.10.2",
	"description": "TUI-first markdown reader on opentui",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carlesandres/house.git",
		"directory": "apps/house"
	},
	"bugs": {
		"url": "https://github.com/carlesandres/house/issues"
	},
	"homepage": "https://github.com/carlesandres/house#readme",
	"keywords": [
		"markdown",
		"reader",
		"terminal",
		"tui",
		"bun",
		"opentui",
		"glow",
		"house"
	],
	"files": [
		"dist/bin.js",
		"dist/index.js",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"bin": {
		"house": "dist/bin.js"
	},
	"scripts": {
		"audit:shipped": "bun run dev/audit-shipped.ts",
		"build": "bun run build:cli",
		"build:cli": "bun run dev/build-cli.ts",
		"build:npm-main": "bun run dev/build-npm-main.ts",
		"build:npm-packages": "bun run dev/build-npm-packages.ts",
		"build:standalone": "bun run dev/build-standalone.ts",
		"build:themes": "bun run dev/build-themes.ts",
		"bench:file-navigator": "bun run dev/bench-file-navigator.tsx",
		"dev": "bun --watch src/index.tsx",
		"format": "oxfmt src/",
		"format:check": "oxfmt --check src/",
		"lint": "oxlint --tsconfig tsconfig.json src/ test/ dev/",
		"npm:pack": "bun run build:npm-main && npm pack --dry-run dist/npm/main",
		"record-demo": "bash recordings/record-demo.sh",
		"repro:pty-codeblocks": "bun run dev/repro-pty-codeblocks.ts",
		"start": "bun run src/index.tsx",
		"smoke:file-navigator:standalone": "bun run dev/smoke-file-navigator.ts standalone",
		"smoke:file-navigator:installed": "bun run dev/smoke-file-navigator.ts installed",
		"test": "bun test",
		"test:preview": "bun run dev/smoke-preview.ts",
		"smoke:preview:artifact": "bun run dev/smoke-preview-artifact.ts",
		"test:pty": "HOUSE_PTY=1 bun test test/pty/",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
		"verify:github": "bun test test/github-emulation.test.ts"
	},
	"optionalDependencies": {
		"@carlesandres/house-darwin-arm64": "0.5.1",
		"@carlesandres/house-darwin-x64": "0.5.1",
		"@carlesandres/house-linux-arm64": "0.5.1",
		"@carlesandres/house-linux-x64": "0.5.1"
	},
	"dependencies": {
		"@effect/atom-react": "4.0.6",
		"@house/options": "workspace:*",
		"@house/ui": "workspace:*",
		"@opentui/core": "0.6.6",
		"@opentui/react": "0.6.6",
		"@parcel/watcher": "2.6.0",
		"@shikijs/core": "4.5.0",
		"@shikijs/engine-javascript": "4.5.0",
		"@shikijs/langs": "4.5.0",
		"@shikijs/themes": "4.5.0",
		"commander": "^14.0.3",
		"effect": "4.0.6",
		"github-slugger": "2.0.0",
		"ignore": "^7.0.13",
		"marked": "^18.1.1",
		"react": "19.3.1",
		"sanitize-html": "2.18.1",
		"scheduler": "0.28.0",
		"string-width": "7.2.0",
		"web-tree-sitter": "0.25.10"
	},
	"devDependencies": {
		"@effect/language-service": "0.87.5",
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"@types/sanitize-html": "2.16.2",
		"emulate": "0.12.2",
		"mermaid": "12.2.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"playwright": "1.64.1",
		"tuistory": "^0.12.0",
		"typescript": "6.0.3"
	}
}
