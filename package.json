{
	"name": "house-monorepo",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "turbo run build",
		"build:cli": "turbo run build:cli --filter=@carlesandres/house",
		"build:npm-main": "turbo run build:npm-main --filter=@carlesandres/house",
		"build:npm-packages": "turbo run build:npm-packages --filter=@carlesandres/house --",
		"build:standalone": "turbo run build:standalone --filter=@carlesandres/house --",
		"build:themes": "turbo run build:themes --filter=@carlesandres/house --",
		"dev": "turbo run dev --filter=@carlesandres/house --",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"lint": "turbo run lint",
		"npm:pack": "turbo run npm:pack --filter=@carlesandres/house",
		"record-demo": "turbo run record-demo --filter=@carlesandres/house",
		"release": "turbo run release --filter=@carlesandres/house --",
		"repro:pty-codeblocks": "turbo run repro:pty-codeblocks --filter=@carlesandres/house --",
		"start": "turbo run start --filter=@carlesandres/house --",
		"test": "turbo run test",
		"test:pty": "turbo run test:pty --filter=@carlesandres/house",
		"typecheck": "turbo run typecheck",
		"verify:github": "turbo run verify:github --filter=@carlesandres/house",
		"version:set": "turbo run version:set --filter=@carlesandres/house --",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
	},
	"devDependencies": {
		"turbo": "2.10.6"
	},
	"packageManager": "bun@1.3.10"
}
